---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Neuro A_Marte — Psicología Infantil y Adolescente',
  description = 'Acompañamos a niños y adolescentes en el tránsito hacia la autorregulación, la atención plena y el bienestar emocional.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div id="intro-overlay">
    <video id="intro-video" src="/videos/intro.mp4" autoplay muted playsinline></video>
    <button id="intro-skip">Saltar →</button>
  </div>

  <canvas id="star-canvas"></canvas>
  <slot />

  <script>
    // ── STARS ──
    const canvas = document.getElementById('star-canvas');
    const ctx = canvas.getContext('2d');
    let stars = [];

    function initStars() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const count = Math.floor((canvas.width * canvas.height) / 4500);
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          r: Math.random() * 1.5 + 0.2,
          base: Math.random() * 0.6 + 0.15,
          speed: Math.random() * 0.8 + 0.2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    let t = 0;
    function drawStars() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      t += 0.016;
      for (const s of stars) {
        const alpha = s.base + Math.sin(t * s.speed + s.phase) * 0.3;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(248,244,255,${Math.max(0, alpha)})`;
        ctx.fill();
      }
      requestAnimationFrame(drawStars);
    }

    initStars();
    drawStars();
    window.addEventListener('resize', initStars);

    // ── INTRO VIDEO ──
    const overlay = document.getElementById('intro-overlay');
    const video   = document.getElementById('intro-video');
    const skip    = document.getElementById('intro-skip');

    if (overlay && video && skip) {
      const el = overlay;
      function dismissIntro() {
        el.classList.add('intro-hidden');
        el.addEventListener('transitionend', () => el.remove(), { once: true });
      }

      video.addEventListener('ended', dismissIntro);
      skip.addEventListener('click', dismissIntro);
    }

    // ── SCROLL REVEAL ──
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    revealEls.forEach((el) => observer.observe(el));
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
