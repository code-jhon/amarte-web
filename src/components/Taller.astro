---
const talleres = [
  {
    num: '1',
    label: 'Taller 1',
    ages: '5 – 8 años',
    emoji: '🌙',
    title: 'Pequeños Exploradores',
    description: 'Introducción al autocontrol y la atención a través del juego sensorial y el movimiento. Actividades cortas, dinámicas y con mucho cuento espacial.',
  },
  {
    num: '2',
    label: 'Taller 2',
    ages: '9 – 12 años',
    emoji: '🪐',
    title: 'Astronautas en Formación',
    description: 'Entrenamiento cognitivo más estructurado: memoria de trabajo, atención sostenida y regulación emocional con retos grupales cooperativos.',
  },
  {
    num: '3',
    label: 'Taller 3',
    ages: '13 – 17 años',
    emoji: '🚀',
    title: 'Cosmonautas',
    description: 'Enfocado en funciones ejecutivas, manejo del estrés digital y habilidades socioemocionales. Dinámicas reflexivas adaptadas a la adolescencia.',
  },
];

const fases = [
  {
    num: '1',
    name: 'Activación',
    time: '10 minutos',
    title: 'Encendido de motores',
    items: ['Juegos motores atencionales', 'Coordinación y alerta cerebral'],
  },
  {
    num: '2',
    name: 'Entrenamiento',
    time: '40 minutos',
    title: 'Entrenamiento Cognitivo',
    items: ['Memoria de trabajo', 'Control inhibitorio', 'Atención sostenida', 'Flexibilidad cognitiva'],
  },
  {
    num: '3',
    name: 'Regulación',
    time: '20 minutos',
    title: 'Regulación Emocional',
    items: ['Técnicas de respiración', 'Pausa cerebral', 'Identificación emocional'],
  },
  {
    num: '4',
    name: 'Misión 🚀',
    time: '20 minutos',
    title: 'Misión Marte',
    items: ['Reto grupal cooperativo', 'Cierre de logro personal'],
  },
];
---

<section id="taller">
  <div class="container">
    <div class="section-header">
      <div class="section-tag reveal">Taller</div>
      <h2 class="reveal" style="transition-delay:0.1s">Misión Marte</h2>
      <p class="section-sub reveal" style="transition-delay:0.2s">
        Un taller presencial de 90 minutos adaptado a cada etapa del desarrollo. Combinamos
        movimiento, cognición y regulación emocional en cuatro fases que simulan un viaje espacial.
      </p>
    </div>

    <div class="talleres-grid reveal" style="transition-delay:0.25s">
      {talleres.map((t) => (
        <div class="taller-card">
          <div class="taller-card-top">
            <div class="taller-num-badge">{t.label}</div>
            <div class="taller-emoji">{t.emoji}</div>
          </div>
          <div class="taller-ages">{t.ages}</div>
          <h3 class="taller-card-title">{t.title}</h3>
          <p class="taller-card-desc">{t.description}</p>
          <div class="taller-price-row">
            <span class="taller-price">$80.000</span>
            <span class="taller-price-label">COP / sesión</span>
          </div>
          <a href="https://forms.gle/gjHJs8NqD855q9x89" target="_blank" rel="noopener" class="btn-taller">Reservar cupo →</a>
        </div>
      ))}
    </div>

    <div class="metodologia reveal" style="transition-delay:0.3s">
      <div class="metodologia-header">
        <div class="section-tag">Metodología compartida · 90 min</div>
        <p>Las cuatro fases se adaptan al grupo de edad, manteniendo la misma estructura.</p>
      </div>
      <div class="taller-fases">
        {fases.map((fase) => (
          <div class="fase">
            <div class="fase-header">
              <div class="fase-num">{fase.num}</div>
              <div class="fase-name">{fase.name}</div>
            </div>
            <div class="fase-time">⏱ {fase.time}</div>
            <h4>{fase.title}</h4>
            <ul>
              {fase.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="taller-bottom reveal" style="transition-delay:0.35s">
      <p class="taller-quote">
        Entrenamos cerebros para vivir en un mundo digital sin perder la atención,
        el aprendizaje y el amor propio.
      </p>
      <a href="https://forms.gle/gjHJs8NqD855q9x89" target="_blank" rel="noopener" class="price-group-cta">¿Reservas el grupo completo? Escríbenos →</a>
    </div>
  </div>
</section>
